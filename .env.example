# Copy this file to .env and fill in real values. Never commit .env.

# Gemini (Google AI Studio -> Get API key)
GEMINI_API_KEY=
# Check AI Studio for the current free model name if this one errors
GEMINI_MODEL=gemini-2.5-flash

# Hub database (Postgres in Docker, host port 5433)
DATABASE_URL=postgresql+psycopg://hub:hub@localhost:5433/hub

# Channel A: WooCommerce (create keys in WP admin: WooCommerce > Settings > Advanced > REST API)
WOO_URL=http://localhost:8080
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# Channel B: PrestaShop, standing in for the marketplace
# (create the key in PrestaShop admin: Advanced Parameters > Webservice)
PRESTASHOP_URL=http://localhost:8081
PRESTASHOP_API_KEY=

# Hub API (used by the Streamlit dashboard)
HUB_URL=http://localhost:8000
